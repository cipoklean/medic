# ─────────────────────────────────────────────────────────────────────────────
# Medic — environment TEMPLATE.
#
#   cp .env.example .env     then fill in the blanks below.
#
# Only lines marked  ◀ FILL IN  need a value from you. Everything else has a
# working default and can be left as-is.
#
# Run any command that touches a provider as:
#     set -a && . ./.env && set +a
# so these values win over anything already exported in your shell. Without
# that, a stale LLM_MODEL in your environment silently overrides this file.
#
# This file is tracked. The real .env never is.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ TRACING — neatlogs ══════════════════════════════════════════════════════
# One ingest key covers local runs, the dashboard and the read-back API.
# Dashboard > API keys.
NEATLOGS_API_KEY=

# Optional. Leave blank unless you are using a scoped token.
NEATLOGS_TOKEN=
NEATLOGS_PROJECT_ID=


# ═══ PROVIDER CHAIN ══════════════════════════════════════════════════════════
# Comma-separated, tried left to right. A named provider that is not fully
# configured is a hard error, never a silent skip: skipping one let a probe
# labelled "openrouter" actually hit Groq's credentials and produce a
# plausible, wrong result. A measurement attributed to the wrong host is worse
# than no measurement.
#
#   litellm  primary gateway — one key, model chosen per role (below)
#   gemini   fallback
LLM_PROVIDER_CHAIN=litellm,gemini

# Which model each ROLE uses when the provider does not pin one explicitly.
# The patient and the medic are different jobs: the patient needs a cheap model
# that fails realistically, the medic needs one that reasons well enough to
# name a span and write a minimal patch.
#   patient  nova-lite  ->  nova-micro  ->  nova-2-lite
#   medic    claude-sonnet-4.6  ->  claude-haiku  ->  gemini
# Verified by scripts/smoke_gateway_models.py; untested models stay untested.


# ─── Primary gateway (LiteLLM) ───────────────────────────────────────────────
# Base URL defaults to https://litellm.vision.aivar.app/v1.
# Uncomment only to point somewhere else:
# LLM_BASE_URL_LITELLM=https://litellm.vision.aivar.app/v1

LLM_API_KEY_LITELLM=


# ─── Fallback (Gemini, OpenAI-compatible endpoint) ───────────────────────────
# Google's model IDs move fast. gemini-2.5-flash is 404 on a current key —
# verified, not assumed — so the fallback pins gemini-3.1-flash-lite, the
# cheapest flash-lite that passes tool calling. Re-check with:
#     .venv/bin/python scripts/list_gemini_models.py
LLM_BASE_URL_GEMINI=https://generativelanguage.googleapis.com/v1beta/openai

LLM_API_KEY_GEMINI=
LLM_MODEL_GEMINI="gemini-3.1-flash-lite"


# ═══ RETIRED PROVIDERS ═══════════════════════════════════════════════════════
# NOT in the chain. Left blank on purpose — fill in only if you need to replay
# evidence recorded before Oct 10. Delete this whole block when you don't.

# NaraRouter — free tier, 15 req/min. Used for the laguna-s-2.1 work.
LLM_API_KEY_NARA=
LLM_MODEL_NARA=laguna-s-2.1
LLM_MODEL_NARA_FALLBACKS=nemotron-3-ultra-free,agnes-2.5-flash

# OpenRouter — reached Groq's gpt-oss-20b with upstream pinning.
LLM_API_KEY_OPENROUTER=
LLM_MODEL_OPENROUTER=openai/gpt-oss-20b
# Pin the upstream so OpenRouter cannot silently switch hosts. Verified to
# report served_provider=Groq with allow_fallbacks=false.
LLM_ROUTE_OPENROUTER=groq

# Generic / default provider, read only when LLM_PROVIDER_CHAIN is unset.
# This was Groq, whose 200,000 tokens/day free tier is why it left the chain.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=


# ═══ RUN LIMITS ══════════════════════════════════════════════════════════════
# Token ceiling per PATIENT run. A step limit alone let one run burn 180,000
# tokens inside 40 steps. Hitting this is reported as the loop it is.
MEDIC_TOKEN_CEILING=30000

# Completion budget for MEDIC'S OWN calls. Must leave room for reasoning tokens.
MEDIC_LLM_MAX_TOKENS=8000

# Per-call cap for the patient. Unset, some providers reserve their full
# advertised ceiling and reject the request outright.
MEDIC_MAX_TOKENS=16384

# Provider requests per minute. NaraRouter's free tier is 15.
MEDIC_RATE_RPM=15

# scripted = deterministic and offline (tests, backup demo).
# live     = the real endpoint above.
MEDIC_LLM_MODE=scripted


# ═══ LOGGING ═════════════════════════════════════════════════════════════════
LOG_LEVEL=INFO
