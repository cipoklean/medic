# ─── Neatlogs ───────────────────────────────────────────────────────────
# Write-only SDK ingest key. Settings > API keys in the Neatlogs dashboard.
NEATLOGS_API_KEY=

# READ credentials are SEPARATE from the ingest key — an ingest credential
# cannot read the Public API (confirmed in their auth docs).
# Settings > Service Accounts > mint a token with context:read + observability:read
NEATLOGS_TOKEN=
NEATLOGS_PROJECT_ID=
# US = https://app.neatlogs.com   |   EU = https://eu.app.neatlogs.com
NEATLOGS_APP_URL=https://app.neatlogs.com

# ─── LLM providers ──────────────────────────────────────────────────────
# Medic supports a FALLBACK CHAIN. Order matters: LLM_PROVIDER_CHAIN is tried
# left to right, and a provider whose budget is exhausted fails over to the
# next. Every span records WHICH provider served it, so evidence/ stays honest.
#
# Reason: a heal bursts diagnose + surgeon + verification on train plus every
# held-out task. Measured cost is ~30k tokens per heal, and Groq's free tier is
# 200,000 tokens/day — roughly 6 heals/day. One provider is not enough for a
# demo that must not fail.
#
# NEVER pin an auto/bynara-style route: it can serve a different model between
# runs, which makes every determinism claim in this project false.
LLM_PROVIDER_CHAIN=nara,groq

# --- provider 1: NaraRouter (primary) ---
# Pin ONE model verified to emit real tool_calls; run
#   .venv/bin/python scripts/smoke_tool_calling.py
# to find which. A model that answers in prose instead of calling tools is
# unusable for both the patient and the diagnosis.
LLM_BASE_URL_NARA=https://router.bynara.id/v1
LLM_API_KEY_NARA=
LLM_MODEL_NARA=
# Rotation order if the primary cannot serve a request (all verified for tool calling)
LLM_MODEL_NARA_FALLBACKS=

# --- provider 2: Groq (fallback) ---
# Only openai/gpt-oss-20b among Groq's reachable models emits real tool_calls;
# gpt-oss-120b and qwen3.8-27b both answer in prose despite the tools array.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# --- optional: any OpenAI-compatible endpoint ---
# OpenAI      : https://api.openai.com/v1
# OpenRouter  : https://openrouter.ai/api/v1
# AWS Bedrock : https://bedrock-runtime.<region>.amazonaws.com/openai/v1
# (Bedrock needs AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Token ceiling for Medic's OWN calls. Must leave room for reasoning tokens:
# openai/gpt-oss-20b spends ~73 of 87 completion tokens thinking on a trivial
# reply, and a truncated budget surfaces as a confusing json_validate_failed.
MEDIC_LLM_MAX_TOKENS=8000

# ─── Runtime ────────────────────────────────────────────────────────────
# scripted = deterministic offline LLM for plumbing tests and dry runs.
# Set to "live" to hit the real endpoint above.
MEDIC_LLM_MODE=live
MEDIC_MAX_ATTEMPTS=3
LOG_LEVEL=INFO