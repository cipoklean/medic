.DS_Store

# Entire: logs and local settings only. settings.json, graph-agent.md and
# .gitignore stay tracked because checkpoints and graph search need them.
.entire/logs/
.entire/settings.local.json

# Logs and OS cruft
*.log
.DS_Store
Thumbs.db

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# Entire's per-agent integration files. They are generated per machine by
# `entire enable --agent <name>` and are specific to whichever agents a
# developer happens to use, so they do not belong in a shared repo. Checkpoints
# still work: .entire/settings.json, graph-agent.md and .gitignore stay tracked.
.agents/
.claude/
.codex/
.cursor/
.factory/
.opencode/
.pi/
.github/
